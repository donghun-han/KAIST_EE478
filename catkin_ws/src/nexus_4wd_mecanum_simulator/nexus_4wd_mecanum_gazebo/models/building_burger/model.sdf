<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='building_burger'>
    <static>true</static>
    <link name='link'>
      <pose>0 0 0.25 0 0 0</pose>

      <!-- Grey building body: 3m wide x 1m deep x 3m tall -->
      <visual name='building'>
        <geometry>
          <box>
            <size>0.5 0.5 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <visual name='sign_front'>
        <pose> 0.0 -0.25 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 0.01 0.5</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://building_burger/materials/scripts</uri>
            <uri>model://building_burger/materials/textures</uri>
            <name>burger</name>
          </script>
        </material>
      </visual>

      <visual name='sign_top'>
        <pose> 0.0 0.0 0.25 -1.57 0 0</pose>
        <geometry>
          <box>
            <size>0.5 0.01 0.5</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://building_burger/materials/scripts</uri>
            <uri>model://building_burger/materials/textures</uri>
            <name>burger</name>
          </script>
        </material>
      </visual>

      <collision name='collision'>
        <geometry>
          <box>
            <size>0.5 0.5 0.5</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
