<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose> -17.8 -19.2 24.8 0 0.7 0.4 </pose>
      </camera>
    </gui>

    <scene>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <shadows>false</shadows>
    </scene>

    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <model name='ground_plane'>
      <pose>10.5 0 -0.005 0 0 0</pose>  <!-- centered on map; z offset avoids z-fighting -->
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 12</size>  <!-- scaled to map area: x(-2~23) y(-5~5) -->
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
              <torsional>
                <ode/>
              </torsional>
            </friction>
            <contact>
              <ode/>
            </contact>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>25 10</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>model://ground_custom/materials/scripts</uri>
              <uri>model://ground_custom/materials/textures</uri>
              <name>ground_custom/plate</name>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <kinematic>0</kinematic>
        <gravity>1</gravity>
        <enable_wind>0</enable_wind>
      </link>
    </model>

    <include>
      <uri>model://AIGC2_start</uri>
	  <pose> 0 0 0.0 0 0 0 </pose>
    </include>

	<!-- ==================================== -->
    <!--  WALL                                -->
	<!-- ==================================== -->

    <include>
      <uri>model://AIGC2_wall_25m</uri>
      <name>AIGC2_wall_25m_1</name>
	  <pose> 10.5 -5 0.0 0 0 0 </pose>
    </include>	

    <include>
      <uri>model://AIGC2_wall_25m</uri>
      <name>AIGC2_wall_25m_2</name>
	  <pose> 10.5 5 0.0 0 0 0 </pose>
    </include>

    <include>
      <uri>model://AIGC2_wall_10m</uri>
      <name>AIGC2_wall_10m_1</name>
	  <pose> 23 0 0.0 0 0 -1.57079 </pose>
    </include>

    <include>
      <uri>model://AIGC2_wall_10m</uri>
      <name>AIGC2_wall_10m_2</name>
	  <pose> -2 0 0.0 0 0 -1.57079 </pose>
    </include>

    <include>
      <uri>model://gate_pair_00</uri>
      <name>gate_pair_0</name>
	  <pose> 3.0 0.0 0.0 0 0 0.0 </pose>
    </include>

	<!-- ==================================== -->
    <!--  2. Wall Obstacle                    -->
	<!-- ==================================== -->

    <include>
      <uri>model://AIGC2_wall_4m</uri>
      <name>AIGC2_wall_4m_1</name>
	  <pose> 13.0 0 0.0 0 0 -1.57079 </pose>
    </include>

    <include>
      <uri>model://AIGC2_wall_3m</uri>
      <name>AIGC2_wall_3m_1</name>
	  <pose> 16.0 2.5 0.0 0 0 -1.57079 </pose>
    </include>

    <include>
      <uri>model://AIGC2_wall_3m</uri>
      <name>AIGC2_wall_3m_2</name>
	  <pose> 16.0 -2.5 0.0 0 0 -1.57079 </pose>
    </include>


	<!-- ==================================== -->
    <!--  3. POLE OBSTACLE                    -->
	<!-- ==================================== -->

    <include>
      <uri>model://AIGC2_wall_2m</uri>
      <name>AIGC2_wall_2m_1</name>
	  <pose> 7.5 -4.0 0.0 0 0 -1.57079 </pose>
    </include>

    <include>
      <uri>model://AIGC2_wall_2m</uri>
      <name>AIGC2_wall_2m_2</name>
	  <pose> 7.5 -3.0 0.0 0 0 0 </pose>
    </include>

    <include>
      <uri>model://AIGC2_pole_30cm</uri>
      <name>AIGC2_pole_30cm_1</name>
	  <pose> 10.5 0.37 0.0 0 0 0 </pose>
    </include>	

    <include>
      <uri>model://construction_cone</uri>
      <name>cone1</name>
	  <pose> 6.96 -0.5 0.0 0 0 0 </pose>
    </include>	

    <include>
      <uri>model://construction_cone</uri>
      <name>cone2</name>
	  <pose> 10 2.3 0.0 0 0 0 </pose>
    </include>	

    <include>
      <uri>model://AIGC2_pole_20cm</uri>
      <name>AIGC2_pole_20cm_2</name>
	  <pose> 8.94 -1.16 0.0 0 0 0 </pose>
    </include>	

    <include>
      <uri>model://AIGC2_pole_20cm</uri>
      <name>AIGC2_pole_20cm_4</name>
	  <pose> 9.7 -3.31 0.0 0 0 0 </pose>
    </include>

    <include>
      <uri>model://AIGC2_pole_10cm</uri>
      <name>AIGC2_pole_10cm_1</name>
	  <pose> 5.93 1.37 0.0 0 0 0 </pose>
    </include>

    <include>
      <uri>model://AIGC2_pole_10cm</uri>
      <name>AIGC2_pole_10cm_2</name>
	  <pose> 6.83 2.8 0.0 0 0 0 </pose>
    </include>

    <include>
      <uri>model://construction_cone</uri>
      <name>cone3</name>
	  <pose> 10.15 -2.04 0.0 0 0 0 </pose>
    </include>

    <include>
      <uri>model://AIGC2_pole_10cm</uri>
      <name>AIGC2_pole_10cm_3</name>
	  <pose> 8.44 2.05 0.0 0 0 0 </pose>
    </include>

    <include>
      <uri>model://construction_cone</uri>
      <name>cone4</name>
	  <pose> 8.14 3.84 0.0 0 0 0 </pose>
    </include>

	<!-- ==================================== -->
    <!--  BUILDINGS                  -->
	<!-- ==================================== -->

    <include>
      <uri>model://building_burger</uri>
      <name>burger</name>
	  <pose> 21.0 0.0 0.0 0 0 -1.57 </pose>
    </include>

    <include>
      <uri>model://building_cafe</uri>
      <name>cafe</name>
	  <pose> 21.0 2.5 0.0 0 0 -1.57 </pose>
    </include>

    <include>
      <uri>model://building_pharmacy</uri>
      <name>pharmacy</name>
	  <pose> 21.0 -2.5 0.0 0 0 -1.57 </pose>
    </include>

	<!-- ==================================== -->
    <!--  9. ETC                              -->
	<!-- ==================================== -->

    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>-23.5641 -21.24295 22.3626 0 0.563642 -0.035802</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>